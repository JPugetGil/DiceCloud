# DiceCloud production settings, read by dicecloud.sh and compose.yml.
# `./dicecloud.sh install` copies this to .env and fills in the passwords;
# .env holds secrets and stays out of git.

# The address players open. Also the sender of account emails:
# no-reply@<this host>
ROOT_URL=https://dicecloud.hemoreg.me

# The app's settings (Google sign-in, S3, legal notices), relative to this folder
SETTINGS_FILE=../../settings.production.json

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel: the token from its
# install command. Empty: the app only answers on this machine
CLOUDFLARE_TUNNEL_TOKEN=

# SMTP for password reset and verification emails, e.g. Brevo:
# smtp://<login with @ written %40>:<SMTP key>@smtp-relay.brevo.com:587
# Empty: the emails are printed in the app's log instead
MAIL_URL=
# Their sender, on a domain the SMTP service has authenticated, e.g.
# DiceCloud <no-reply@hemoreg.me>. Empty: no-reply@<the ROOT_URL host>
MAIL_FROM=

# What a new account is subscribed to, so that it can build a character at
# once: library collection ids and library ids, comma-separated (the address
# of a collection's page ends with its id). Read when an account is created;
# empty: new accounts follow nothing and must find the community libraries
DEFAULT_LIBRARY_COLLECTIONS=
DEFAULT_LIBRARIES=

# MongoDB, generated by install: keep them, the database was created with them
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_REPLICA_KEY=
MONGO_APP_DATABASE=dicecloud

# Daily backups: where, and how many days are kept
BACKUP_DIR=/srv/dicecloud/backups
BACKUP_KEEP_DAYS=7
# When to back up (systemd OnCalendar), applied by install
BACKUP_TIME='*-*-* 03:30:00'

# Optional copy of the backups outside the house, to an S3 bucket: the same
# BACKUP_KEEP_DAYS days are kept there. Empty bucket: no copy
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dicecloud-backups
BACKUP_S3_REGION=eu-west-3
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Only for an S3-compatible service other than AWS
BACKUP_S3_ENDPOINT=
# Where ./dicecloud.sh snapshots keeps the library import kit, in that bucket
SNAPSHOTS_S3_PREFIX=library-snapshots

# The app's port on this machine (the tunnel does not use it)
APP_LOCAL_PORT=3000
COMPOSE_PROJECT_NAME=dicecloud
