{
  "name": "dicecloud",
  "version": "2.1.0",
  "description": "Online Realtime TTRPG Engine",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JPugetGil/DiceCloud"
  },
  "author": "Thaum Rystra",
  "scripts": {
    "serve": "meteor run --raw-logs --settings settings.json",
    "debug": "meteor --inspect",
    "bundle-viz": "meteor --extra-packages bundle-visualizer --production",
    "lint": "eslint .",
    "test": "meteor test --once --driver-package meteortesting:mocha --port 3100 --raw-logs",
    "typecheck": "node ../tests/types/checkTypes.mjs",
    "build": "meteor build ../build --architecture os.linux.x86_64"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    },
    "testModule": "tests/main.js",
    "modern": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@babel/runtime": "^7.29.7",
    "@swc/helpers": "^0.5.17",
    "alea": "^1.0.1",
    "chroma-js": "^3.2.0",
    "css-box-shadow": "^1.0.0-3",
    "cytoscape": "^3.34.3",
    "cytoscape-klay": "^3.1.4",
    "date-fns": "^4.4.0",
    "ddp-rate-limiter-mixin": "^1.1.10",
    "dompurify": "^3.4.16",
    "lodash": "^4.18.1",
    "marked": "^18.0.14",
    "marked-gfm-heading-id": "^4.1.4",
    "meteor-node-stubs": "^1.2.30",
    "moo": "^0.5.3",
    "nearley": "^2.19.1",
    "ngraph.graph": "^20.1.2",
    "ngraph.path": "^1.6.1",
    "pinia": "^4.0.3",
    "pretty-bytes": "^7.2.0",
    "qrcode.vue": "^3.11.0",
    "speakingurl": "^14.0.1",
    "thumbhash": "^0.1.1",
    "type-fest": "^5.10.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-meteor-tracker": "3.0.0-beta.7",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@meteorjs/rspack": "3.0.0-beta.3",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@types/chai": "^5.2.3",
    "@types/lodash": "^4.17.25",
    "@types/meteor-mdg-validated-method": "^1.2.12",
    "@types/mocha": "^10.0.10",
    "@types/simpl-schema": "^1.12.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vue/compiler-sfc": "^3.5.43",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "globals": "^17.12.0",
    "rspack-vue-loader": "^17.7.0",
    "typescript": "^6.0.3"
  }
