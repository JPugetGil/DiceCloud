{
  "compilerOptions": {
    "module": "esNext",
    "moduleResolution": "Bundler",
    "target": "es2018",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitAny": false,
    "preserveSymlinks": true,
    "allowJs": true,
    "checkJs": true,
    "noErrorTruncation": true,
    // The declarations of node_modules and of Meteor's generated types are
    // not the app's to fix: checking them found only errors nobody acts on,
    // and took two thirds of the time
    "skipLibCheck": true,
    "outDir": "build",
    "paths": {
      "/*": [
        "./*"
      ],
      "meteor/*": [
        "./.meteor/local/types/packages.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    // TypeScript 6 loads no @types package unless listed: these declare
    // globals (Node, mocha). Meteor's own types are zodern:types', in
    // .meteor/local/types; @types/meteor (Meteor 2) is never loaded
    "types": ["node", "mocha"],
  },
  "vueCompilerOptions": {
    "target": 3
  },
  // Not the app's code: generated files (the grammar, declared by
  // grammar.d.ts; the production chunks a local build leaves in public/),
  // tooling configuration, and public/sw.js, a service worker script served
  // as is, outside the app's modules
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    ".meteor",
    "_build",
    "public",
    "imports/parser/grammar.js",
    "eslint.config.mjs",
    "rspack.config.js"
  ]
}
